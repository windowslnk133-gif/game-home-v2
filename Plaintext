│
├── runinger/               <-- 【遊戲資料夾 1】
│   ├── system.json         <-- 存在此檔 = 判定為 Game
│   ├── index.html          <-- 遊戲專屬介紹頁 (可填 "none")
│   ├── game.html           <-- 遊戲主程式 (可填 "none")
│   ├── cover.png           <-- 遊戲圖像
│   ├── preview.mp4         <-- 預覽影片 (選填)
│   ├── style.css           <-- (首頁會自動隱藏，不顯示)
│   └── main.js             <-- (首頁會自動隱藏，不顯示)
│
└── normal-folder/          <-- 【一般資料夾】沒有 system.json，首頁會自動跳過
    └── style.css
